# Yellowstone gRPC endpoint + auth (Triton / Helius LaserStream / QuickNode).
# Pull the host + token from your provider dashboard. Never commit real values.
GRPC_ENDPOINT=https://your-endpoint.example.com:443
GRPC_X_TOKEN=your-provider-token

# Optional RPC for backfill / IDL fetch.
RPC_HTTP=https://api.mainnet-beta.solana.com
RPC_WS=wss://api.mainnet-beta.solana.com

# Optional: where the live watcher should emit (used by examples that support a webhook sink).
WEBHOOK_URL=
